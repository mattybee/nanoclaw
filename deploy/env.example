# Copy to /srv/nanoclaw/deploy/stack.env on the VPS (never commit secrets).
#   cp deploy/env.example deploy/stack.env

NANOCLAW_ROOT=/home/matty/nanoclaw
DOCKER_GID=983
HOST_UID=1001
HOST_GID=1001
# Required when the daemon has userns-remap (this VPS does).
DOCKER_USERNS=host
TZ=Australia/Brisbane

# Pin the agent image loaded onto the VPS (do not rebuild on 1 GB RAM).
CONTAINER_IMAGE=nanoclaw-agent-v2-91157e97:latest
CONTAINER_MEMORY_LIMIT=400m
CONTAINER_PIDS_LIMIT=512
NANOCLAW_EGRESS_LOCKDOWN=true

ONECLI_VERSION=1.41.0
ONECLI_APP_PORT=10254
ONECLI_GATEWAY_PORT=10255
POSTGRES_USER=onecli
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onecli
# Do not set NEXTAUTH_SECRET unless you also set Google OAuth client id/secret.
# Unset = single-user local mode, which is what the SSH-tunnel vault UI needs.
